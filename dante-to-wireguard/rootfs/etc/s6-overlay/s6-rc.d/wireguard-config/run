#!/command/with-contenv bashio
# ==============================================================================
# Rotate WireGuard configuration and add LAN routing
# ==============================================================================

mapfile -t CONFIG_FILES < <(find /config -maxdepth 1 -name "wg*.conf" 2>/dev/null | sort -V)
if [ ${#CONFIG_FILES[@]} -eq 0 ]; then
    mapfile -t CONFIG_FILES < <(find /config -maxdepth 1 \( -name "wireguard*.conf" -o -name "*.conf" \) ! -name "sockd.conf" 2>/dev/null | sort -V)
fi

TOTAL_FILES=${#CONFIG_FILES[@]}
if [ "$TOTAL_FILES" -eq 0 ]; then
    bashio::log.fatal "WireGuard configuration file not found in /config!"
    bashio::exit.nok
fi

LAST_USED=""
if [ -f /data/.wireguard_last_used ]; then
    LAST_USED=$(cat /data/.wireguard_last_used)
fi

SELECTED_INDEX=0
if [ -n "$LAST_USED" ]; then
    for i in "${!CONFIG_FILES[@]}"; do
        if [ "$(basename "${CONFIG_FILES[$i]}")" = "$LAST_USED" ]; then
            SELECTED_INDEX=$(( (i + 1) % TOTAL_FILES ))
            break
        fi
    done
fi

SELECTED_FILE="${CONFIG_FILES[$SELECTED_INDEX]}"
SELECTED_FILENAME=$(basename "$SELECTED_FILE")

bashio::log.debug "Selected WireGuard configuration ($(( SELECTED_INDEX + 1 ))/${TOTAL_FILES}): ${SELECTED_FILENAME}"

mkdir -p /data
echo "$SELECTED_FILENAME" > /data/.wireguard_last_used

DNS_IPS=$(grep -i '^[ \t]*DNS[ \t]*=' "$SELECTED_FILE" | cut -d'=' -f2- | tr ',' ' ')
DNS_ROUTING=""
for IP in $DNS_IPS; do
    # Check for IPv4
    if [[ "$IP" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        DNS_ROUTING="${DNS_ROUTING}\nPostUp = ip rule add to $IP table 51820 2>/dev/null || true\nPreDown = ip rule del to $IP table 51820 2>/dev/null || true"
    # Check for IPv6 (contains a colon)
    elif [[ "$IP" == *":"* ]]; then
        DNS_ROUTING="${DNS_ROUTING}\nPostUp = ip -6 rule add to $IP table 51820 2>/dev/null || true\nPreDown = ip -6 rule del to $IP table 51820 2>/dev/null || true"
    fi
done

ROUTING_BLOCK="\nTable = 51820\nPostUp = ip rule add oif wg0 table 51820; ip -6 rule add oif wg0 table 51820 2>/dev/null || true\nPreDown = ip rule del oif wg0 table 51820; ip -6 rule del oif wg0 table 51820 2>/dev/null || true${DNS_ROUTING}\n"

mkdir -p /etc/wireguard
TARGET_CONF="/etc/wireguard/wg0.conf"

MTU_VALUE=""
if bashio::config.exists 'mtu' && bashio::config.has_value 'mtu'; then
    MTU_VALUE=$(bashio::config 'mtu')
fi

awk -v block="$ROUTING_BLOCK" -v mtu="$MTU_VALUE" '
tolower($0) ~ /^[ \t]*mtu[ \t]*=/ {
    next
}
tolower($0) ~ /^[ \t]*table[ \t]*=/ {
    next
}
!inserted && /^\[Peer\]/ {
    if (mtu != "") print "MTU = " mtu
    if (block != "") print block
    inserted=1
}
{ print }
END {
    if (!inserted) {
        if (mtu != "") print "MTU = " mtu
        if (block != "") print "\n" block
    }
}
' "$SELECTED_FILE" > "$TARGET_CONF"
